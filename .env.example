POSTGRES_DB=studyforge
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://studyforge:change-this-local-password@db:5432/studyforge
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720
# Server-side Google Gemini API key; never expose through a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
# Question generation uses Gemma 4; document extraction uses its own vision model.
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
DOCUMENT_VISION_MODEL_ID=gemini-2.5-flash
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
MAX_SOURCE_CHARS=100000
MAX_QUESTIONS_PER_GENERATION=40
